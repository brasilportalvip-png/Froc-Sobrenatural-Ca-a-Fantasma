# GEMINI_API_KEY: Obrigatório para chamadas de IA do Gemini.
# Configure nas variáveis de ambiente da plataforma (ex: painel da Vercel / Secrets da AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL canônica onde a aplicação está hospedada (ex: https://froc-sobrenatural-ca-a-fantasma.vercel.app).
# Usada para links auto-referenciais, callbacks e validações.
APP_URL="MY_APP_URL"

# Mercado Pago Credentials (server-side only)
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Preços dos pacotes em centavos de BRL (ex: 2990 = R$ 29,90)
# Se mantidos em "0", os botões de compra não são disponibilizados.
PACKAGE_50_PRICE_CENTS="0"
PACKAGE_75_PRICE_CENTS="0"
PACKAGE_100_PRICE_CENTS="0"

# Firebase Admin Service Account (Produção / Vercel / Cloud)
# NUNCA versione arquivos de credenciais no repositório Git!
# Em produção (Vercel), configure a variável de ambiente secreta FIREBASE_SERVICE_ACCOUNT_KEY
# com o conteúdo JSON da Service Account gerada no Firebase Console ou codificada em Base64:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"froc-sobrenatural",...}'
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Allowlist de UIDs de Administradores (separados por vírgula)
# Acesso ao Painel Administrativo (/admin) e Concessão Manual de Créditos
# Ex: ADMIN_UIDS="dJ2K9sL01...,a7B8c9D01..."
ADMIN_UIDS=""
