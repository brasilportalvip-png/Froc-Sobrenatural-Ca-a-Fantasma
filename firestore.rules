rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: Authorized users can read only their own basic profile.
    // Client writes are strictly forbidden (allow write: if false) to prevent tampering with
    // emailVerified, authProvider, uid, createdAt, timestamps, or roles.
    // All profile provisioning, mutations, and synchronization happen authoritatively via Firebase Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Wallets: User can ONLY read their own wallet. Clients NEVER write balance, version, or reserved!
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only backend (Admin SDK) can write to wallet

      // Ledger: User can ONLY read their ledger entries
      match /ledger/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false; // Append-only by backend (Admin SDK)
      }
    }

    // Free Grants: User can ONLY read if grant was applied to them. Never write from client.
    match /freeGrants/{grantId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Consultations: User can read their own consultations. Write handled exclusively by backend.
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Orders: User can read their own orders. Only backend writes order status and token.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Tool Sessions: User can read their own tool sessions. Write handled exclusively by backend (Admin SDK).
    match /toolSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Tool Session Locks: Locks determinísticos por UID + ToolId (Gerenciados exclusivamente pelo Admin SDK)
    match /toolSessionLocks/{lockId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Evidence & Media references stored in Firestore (Cadeia de Custódia Forense com Imutabilidade Estrita)
    // Registros forenses de campo não podem ser apagados pelo cliente (allow delete: if false)
    // Edições são permitidas apenas se preservarem estritamente uid, sessionId, timestamp, photoDataUrl e signalData
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.timestamp == resource.data.timestamp &&
        (!('photoDataUrl' in resource.data) || request.resource.data.photoDataUrl == resource.data.photoDataUrl) &&
        (!('signalData' in resource.data) || request.resource.data.signalData == resource.data.signalData);
      allow delete: if false; // Imutabilidade da cadeia de custódia forense
    }

    // Payment events, audit logs, risk events: Internal only, never readable by standard clients
    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    match /adminAdjustmentIdempotency/{keyId} {
      allow read, write: if false;
    }

    match /rateLimits/{keyId} {
      allow read, write: if false;
    }

    match /systemConfig/{configId} {
      allow read: if true; // Public catalog of packages & prices
      allow write: if false;
    }
  }
}
